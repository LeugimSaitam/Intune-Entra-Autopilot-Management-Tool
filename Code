function Get-PCIntune {

    param($Pesquisa)

    Add-Log "A procurar no Intune: $Pesquisa" 

    $Device = Get-MgDeviceManagementManagedDevice -All |
    Where-Object {
        $_.DeviceName -eq $Pesquisa -or
        $_.SerialNumber -eq $Pesquisa
    }

    if($Device){
        Add-Log "Encontrado no Intune!"
    }
    else{
        Add-Log "Não encontrado no Intune!"
    }

    return $Device
}

function Get-PCEntra {

    param($Pesquisa)

    Add-Log "A procurar no Entra: $Pesquisa"

    try {

        $Device = Get-MgDevice `
            -Filter "displayName eq '$Pesquisa'"

        if($Device){
            Add-Log "✅ Encontrado no Entra ID!"
        }
        else{
            Add-Log "❌ Não encontrado no Entra ID!"
        }

        return $Device

    }
    catch {

        Add-Log "❌ ERRO Entra ID"
        Add-Log $_.Exception.Message

        return $null
    }
}
function Get-PCAutopilot {

    param($SerialNumber)

    Add-Log "A procurar no Autopilot: $SerialNumber"

    $AutoPilot = Get-MgDeviceManagementWindowsAutopilotDeviceIdentity -All |
    Where-Object {
        $_.SerialNumber -eq $SerialNumber
    }

    if($AutoPilot){
        Add-Log "Encontrado no Autopilot!"
    }
    else{
        Add-Log "Não encontrado no Autopilot!"
    }

    return $AutoPilot
}

function Get-PC {

    param($Pesquisa)

    $Intune = Get-PCIntune $Pesquisa

    $Entra = Get-PCEntra $Pesquisa $Pesquisa

    $Autopilot = Get-PCAutopilot $Pesquisa

    $Serial = $null
    $Modelo = $null
    $Utilizador = $null
    $DeviceName = $Pesquisa

    if($Intune){

        $Serial = $Intune.SerialNumber
        $Modelo = $Intune.Model
        $Utilizador = $Intune.UserPrincipalName
        $DeviceName = $Intune.DeviceName

        if(!$Autopilot){

            $Autopilot = Get-PCAutopilot $Serial

        }

    }

    [PSCustomObject]@{

        DeviceName = $DeviceName
        Serial = $Serial
        Modelo = $Modelo
        Utilizador = $Utilizador

        Intune = ($null -ne $Intune)
        Entra = ($null -ne $Entra)
        Autopilot = ($null -ne $Autopilot)

        IntuneId = if($Intune){$Intune.Id}else{$null}
        EntraId = if($Entra){$Entra.Id}else{$null}
        AutopilotId = if($Autopilot){$Autopilot.Id}else{$null}

    }

}

function Remove-PCIntune {

    param($ManagedDeviceId)

    Remove-MgDeviceManagementManagedDevice `
        -ManagedDeviceId $ManagedDeviceId
}
function Remove-PCEntra {

    param($EntraId)

    Remove-MgDevice `
        -DeviceId $EntraId

}

function Remove-PCAutopilot {

    param($AutopilotId)

    Remove-MgDeviceManagementWindowsAutopilotDeviceIdentity `
        -WindowsAutopilotDeviceIdentityId $AutopilotId

}
function Add-Log {

    param([string]$Message)

    $Hora = Get-Date -Format "HH:mm:ss"

    Write-Host "[$Hora] $Message"

    if($null -ne $txtLog){
        $txtLog.AppendText("[$Hora] $Message`r`n")
    }
}
